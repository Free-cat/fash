BOT_TOKEN=your_telegram_bot_token
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-3.1-flash-image
OPENROUTER_STYLE_GUIDE_MODEL=openai/gpt-image-2

# Bot locale: en (FitRoom) or ru (Моя примерка)
BOT_LOCALE=en

# Optional overrides
DATABASE_PATH=data/bot.db
STORAGE_PATH=data/storage
FREE_CREDITS=2
# Optional legacy setting (person photo count is unlimited)
MAX_USER_PHOTOS=5

# Owner admin command (/stats)
OWNER_TELEGRAM_ID=

# Webhook deployment (production)
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.example.com
WEBHOOK_SECRET=your_random_webhook_secret

# Photo guide asset
GUIDE_PHOTO_PATH=assets/guide/photo_guide.jpg

# How-it-works demo image (shown on /start and /help)
DEMO_IMAGE_PATH=assets/demo/how_it_works.jpg
