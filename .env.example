BOT_TOKEN=your_telegram_bot_token
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-3.1-flash-image
OPENROUTER_STYLE_GUIDE_MODEL=google/gemini-3-pro-image

# Bot locale: en (FitRoom) or ru (Моя примерка)
BOT_LOCALE=en

# Optional overrides
DATABASE_PATH=data/bot.db
STORAGE_PATH=data/storage
FREE_CREDITS=2
# Optional legacy setting (person photo count is unlimited)
MAX_USER_PHOTOS=5

# Owner admin command (/stats)
OWNER_TELEGRAM_ID=

# Production (Coolify / Docker): webhook required
USE_WEBHOOK=true
WEBHOOK_URL=https://fitroom.example.com
WEBHOOK_SECRET=generate_with_openssl_rand_hex_32

# Local dev: USE_WEBHOOK=false (polling, no port 8080 needed)

# Photo guide asset
GUIDE_PHOTO_PATH=assets/guide/photo_guide.jpg

# How-it-works demo image (shown on /start and /help)
DEMO_IMAGE_PATH=assets/demo/how_it_works.jpg

# Premium style guide preview (showcase offer)
PREMIUM_PREVIEW_PATH=assets/guide/premium_preview.jpg

# Animated sticker shown while generation is running (optional override)
GENERATING_STICKER_ID=CAACAgQAAxkBAAERjX1qWVwwGE_33I-okc4In27JE9j5HgACKhEAAv9X8FH2t7Ww8CdM8D0E
